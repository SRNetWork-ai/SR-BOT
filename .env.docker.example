# نمونهٔ متغیرهای داکر — این فایل را به .env کپی کنید و مقدارها را عوض کنید
# دقت: این متغیرها فقط برای docker compose است؛ تنطیمات خود برنامه در config.php ذخیره می‌شود

# پورتی که روی سرور باز می‌شود (پشت آن nginx کانتینر)
WEB_PORT=8080

# منطقهٔ زمانی و فاصلهٔ اجرای وظایف دوره‌ای (برحسب ثانیه)
TZ=Asia/Tehran
CRON_INTERVAL=300

# دیتابیس داخل کانتینر؛ در نصاب وب، هاست را db بنویسید
DB_NAME=srbot
DB_USER=srbot
DB_PASS=change_me_strong
DB_ROOT_PASS=change_me_root
