# ------------------------------------------------------------
# SR-BOT — نمونه کانفیگ nginx
# فایل .htaccess فقط روی Apache اثر دارد. اگر وب‌سرور شما nginx است،
# این نمونه را در server block سایت خود بگذارید و مسیرها را مطابق سرور تنظیم کنید.
# بدون این قواعد، پوشه‌های حساس مثل storage و database از وب قابل دسترسی می‌مانند!
# ------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name bot.example.com;

    # ssl_certificate     /etc/letsencrypt/live/bot.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/bot.example.com/privkey.pem;

    root /var/www/sr-bot;      # مسیر پروژه را اینجا تنظیم کنید
    index index.php;

    client_max_body_size 64m;
    server_tokens off;

    # --- هدرهای امنیتی ---
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # --- مسیرهای حساس: دسترسی وب کاملاً بسته ---
    location ~ ^/(app|storage|cron|tools|docs|database)/ { deny all; return 404; }

    # فایل پیکربندی و نمونهٔ آن
    location ~ ^/config(\.sample)?\.php$ { deny all; return 404; }

    # فایل‌های مخفی (.git، .env، .htaccess و …)
    location ~ /\. { deny all; return 404; }

    # پسوندهای خطرناک یا غیرلازم روی وب
    location ~* \.(sql|zip|log|md|sh|neon|dist|sample|lock|bak|old|env)$ { deny all; return 404; }

    # جلوگیری از اجرای PHP داخل پوشهٔ دارایی‌ها
    location ~ ^/assets/.*\.php$ { deny all; return 404; }

    # --- پنل مدیریت: بستن فریم ---
    location ^~ /admin/ {
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        try_files $uri $uri/ /admin/index.php?$query_string;
    }

    # --- لینک زیبای اشتراک (معادل قواعد .htaccess) ---
    rewrite ^/sub/([A-Za-z0-9_-]{6,64})/(json|raw|html|base64|dl)/?$ /sub.php?id=$1&fmt=$2 last;
    rewrite ^/sub/([A-Za-z0-9_-]{6,64})/?$                           /sub.php?id=$1        last;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        # سوکت PHP-FPM خود را تنظیم کنید — مثال: php8.2-fpm
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_read_timeout 120;
    }
}

# نکته ۱: دانلود بکاپ از داخل پنل مدیریت انجام می‌شود و به مسیر مستقیم نیاز ندارد؛
#         بستن پسوند zip و sql روی وب مشکلی در کارکرد پنل ایجاد نمی‌کند.
# نکته ۲: پس از پایان نصب، پوشهٔ install/ را از سرور حذف کنید. اگر بماند،
#         خود برنامه آن را قفل می‌کند و فقط با ساختن فایل storage/tmp/install.unlock باز می‌شود.
# نکته ۳: درستی این قواعد را می‌توانید در پنل → سلامت سیستم → «محافظت فایل‌های حساس» ببینید.
