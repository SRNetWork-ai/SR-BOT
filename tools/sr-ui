#!/usr/bin/env bash
# SR-UI — مدیر خط فرمان SR-BOT
#   sr-ui                 منوی تعاملی
#   sr-ui status|start|stop|restart|update|backup|restore|migrate|webhook|token|ssl|domain|cron|logs|perms|db|info|url|uninstall
set -uo pipefail

CONF="/etc/sr-bot/sr-ui.conf"
if [ ! -r "$CONF" ]; then
  echo "SR-BOT روی این سرور نصب نشده (فایل $CONF پیدا نشد)."
  echo "نصب: bash <(curl -fsSL https://raw.githubusercontent.com/SRNetWork-ai/SR-BOT/main/install.sh)"
  exit 1
fi
# shellcheck disable=SC1090
. "$CONF"

ROOT_DIR="${ROOT_DIR:-/var/www/sr-bot}"
PHPBIN="${PHPBIN:-php}"
WEBUSER="${WEBUSER:-www-data}"
FPM_SERVICE="${FPM_SERVICE:-php-fpm}"
PORT="${PORT:-80}"
DOMAIN="${DOMAIN:-}"
VHOST="${VHOST:-/etc/nginx/conf.d/sr-bot.conf}"
DB_NAME="${DB_NAME:-srbot}"
DB_USER="${DB_USER:-srbot}"
DB_PASS="${DB_PASS:-}"
REPO="${REPO:-SRNetWork-ai/SR-BOT}"
BRANCH="${BRANCH:-main}"

C0=$'\033[0m'; CB=$'\033[1;36m'; CG=$'\033[1;32m'; CY=$'\033[1;33m'; CR=$'\033[1;31m'
say(){ printf '%s %s\n' "${CB}==>${C0}" "$*"; }
ok(){ printf '%s %s\n' "${CG}[ok]${C0}" "$*"; }
warn(){ printf '%s %s\n' "${CY}[!]${C0}" "$*"; }
err(){ printf '%s %s\n' "${CR}[x]${C0}" "$*"; }
pause(){ printf '\n'; read -r -p "Enter برای ادامه…" _ || true; }

cli(){
  if command -v sudo >/dev/null 2>&1 && id -u "$WEBUSER" >/dev/null 2>&1; then
    ( cd "$ROOT_DIR" && sudo -u "$WEBUSER" "$PHPBIN" cli.php "$@" )
  else
    ( cd "$ROOT_DIR" && "$PHPBIN" cli.php "$@" )
  fi
}

svc(){ if systemctl "$1" "$2" >/dev/null 2>&1; then ok "$2 ← $1"; else warn "$2: $1 انجام نشد"; fi; }

site_url(){
  local host="$DOMAIN"
  if [ -z "$host" ]; then host="$(hostname -I 2>/dev/null | awk '{print $1}')"; fi
  if grep -q "listen 443" "$VHOST" 2>/dev/null; then printf 'https://%s' "$host"
  elif [ "$PORT" = "80" ]; then printf 'http://%s' "$host"
  else printf 'http://%s:%s' "$host" "$PORT"; fi
}

c_status(){
  say "وضعیت سرویس‌ها"
  local s
  for s in nginx "$FPM_SERVICE" mariadb mysql; do
    if systemctl list-unit-files 2>/dev/null | grep -q "^$s.service"; then
      printf '  %-14s %s\n' "$s" "$(systemctl is-active "$s" 2>/dev/null)"
    fi
  done
  if [ -f /etc/cron.d/sr-bot ]; then printf '  %-14s %s\n' "cron" "فعال"; else printf '  %-14s %s\n' "cron" "غیرفعال"; fi
  printf '  %-14s %s\n' "path" "$ROOT_DIR"
  printf '  %-14s %s\n' "url" "$(site_url)"
  if [ -f "$ROOT_DIR/version.json" ]; then
    printf '  %-14s %s\n' "version" "$(grep -o '\"version\"[^,]*' "$ROOT_DIR/version.json" | head -n1 | cut -d: -f2 | tr -d ' \"')"
    printf '  %-14s %s\n' "build" "$(grep -o '\"build\"[^,]*' "$ROOT_DIR/version.json" | head -n1 | cut -d: -f2 | tr -d ' \"')"
  fi
  if [ -f "$ROOT_DIR/config.php" ]; then ok "config.php موجود است"
  else warn "config.php ساخته نشده؛ نصاب وب: $(site_url)/install/"; fi
  printf '  %-14s %s\n' "http" "$(curl -s -o /dev/null -w '%{http_code}' --max-time 6 "$(site_url)/" 2>/dev/null || echo 000)"
}

c_restart(){ svc restart nginx; svc restart "$FPM_SERVICE"; }
c_start(){ svc start nginx; svc start "$FPM_SERVICE"; }
c_stop(){ svc stop nginx; }

c_perms(){
  chown -R "$WEBUSER":"$WEBUSER" "$ROOT_DIR" 2>/dev/null || true
  find "$ROOT_DIR" -type d -exec chmod 755 {} + 2>/dev/null || true
  find "$ROOT_DIR" -type f -exec chmod 644 {} + 2>/dev/null || true
  chmod -R 775 "$ROOT_DIR/storage" 2>/dev/null || true
  if [ -f "$ROOT_DIR/config.php" ]; then chmod 640 "$ROOT_DIR/config.php"; fi
  ok "مجوزها اصلاح شد."
}

c_update(){
  say "بررسی نسخه از $REPO@$BRANCH"
  cli check || true
  local a=""
  read -r -p "به‌روزرسانی انجام شود؟ (y/n) [y]: " a || true
  if [ "$a" = "n" ] || [ "$a" = "N" ]; then return 0; fi
  cli update
  c_perms
  svc restart "$FPM_SERVICE"
}

c_backup(){
  local a=""
  read -r -p "نوع بکاپ (db/full) [db]: " a || true
  if [ "$a" != "full" ]; then a="db"; fi
  cli backup "$a"
}

c_restore(){
  cli list
  local f=""
  read -r -p "نام فایل بکاپ: " f || true
  if [ -z "$f" ]; then warn "نامی وارد نشد."; return 0; fi
  cli restore "$f"
}

c_logs(){
  say "۲۰ خط آخر لاگ‌ها"
  local f
  for f in /var/log/nginx/sr-bot.error.log "$ROOT_DIR/storage/logs/app.log" "$ROOT_DIR/storage/logs/error.log"; do
    if [ -f "$f" ]; then printf '\n--- %s ---\n' "$f"; tail -n 20 "$f"; fi
  done
  if [ -d "$ROOT_DIR/storage/logs" ]; then
    printf '\n--- فایل‌های لاگ ---\n'
    ls -1t "$ROOT_DIR/storage/logs" 2>/dev/null | head -n 10
  fi
}

c_webhook(){
  local a=""
  read -r -p "عملیات وبهوک (info/set/del) [info]: " a || true
  if [ -z "$a" ]; then a="info"; fi
  cli hook "$a"
}

c_token(){
  local t=""
  read -r -p "توکن جدید ربات: " t || true
  if [ -z "$t" ]; then warn "توکنی وارد نشد."; return 0; fi
  cli token "$t" --force
}

c_ssl(){
  if [ -z "$DOMAIN" ]; then
    read -r -p "دامنه: " DOMAIN || true
    if [ -z "$DOMAIN" ]; then warn "بدون دامنه ممکن نیست."; return 0; fi
    sed -i "s|^DOMAIN=.*|DOMAIN=\"$DOMAIN\"|" "$CONF"
  fi
  if ! command -v certbot >/dev/null 2>&1; then
    if command -v apt-get >/dev/null 2>&1; then
      DEBIAN_FRONTEND=noninteractive apt-get install -y certbot python3-certbot-nginx >/dev/null 2>&1 || true
    elif command -v dnf >/dev/null 2>&1; then
      dnf install -y certbot python3-certbot-nginx >/dev/null 2>&1 || true
    else
      yum install -y certbot python3-certbot-nginx >/dev/null 2>&1 || true
    fi
  fi
  if certbot --nginx -d "$DOMAIN" --agree-tos --redirect --non-interactive --register-unsafely-without-email; then
    ok "SSL فعال شد: https://$DOMAIN"
  else
    err "نصب SSL ناموفق بود."
  fi
}

c_domain(){
  local d="" p=""
  read -r -p "دامنهٔ جدید [$DOMAIN]: " d || true
  read -r -p "پورت جدید [$PORT]: " p || true
  if [ -n "$d" ]; then DOMAIN="$d"; fi
  if [ -n "$p" ]; then PORT="$p"; fi
  if [ -f "$VHOST" ]; then
    sed -i "s|^\\( *listen \\).*;|\\1$PORT;|" "$VHOST"
    sed -i "s|^\\( *server_name \\).*;|\\1${DOMAIN:-_};|" "$VHOST"
    if nginx -t >/dev/null 2>&1; then
      systemctl reload nginx >/dev/null 2>&1 || true
      ok "وب‌سرور به‌روز شد."
    else
      err "پیکربندی nginx معتبر نیست؛ تغییر را برگردانید."
    fi
  fi
  sed -i "s|^DOMAIN=.*|DOMAIN=\"$DOMAIN\"|" "$CONF"
  sed -i "s|^PORT=.*|PORT=\"$PORT\"|" "$CONF"
  warn "آدرس سایت را در پنل (تنظیمات ← آدرس) هم عوض کنید و وبهوک را دوباره ست کنید (گزینهٔ ۷)."
}

c_cron(){
  if [ -f /etc/cron.d/sr-bot ]; then
    cat /etc/cron.d/sr-bot
    local a=""
    read -r -p "حذف شود؟ (y/n) [n]: " a || true
    if [ "$a" = "y" ]; then rm -f /etc/cron.d/sr-bot; ok "کران حذف شد."; fi
  else
    printf '%s\n' "*/5 * * * * $WEBUSER $PHPBIN $ROOT_DIR/cron/tasks.php >/dev/null 2>&1" >/etc/cron.d/sr-bot
    chmod 644 /etc/cron.d/sr-bot
    ok "کران هر ۵ دقیقه فعال شد."
  fi
}

c_db(){
  say "کنسول دیتابیس $DB_NAME (خروج: exit)"
  mysql -u"$DB_USER" -p"$DB_PASS" "$DB_NAME"
}

c_info(){
  say "اطلاعات نصب"
  printf '  path  : %s\n' "$ROOT_DIR"
  printf '  url   : %s\n' "$(site_url)"
  printf '  db    : %s (user %s)\n' "$DB_NAME" "$DB_USER"
  printf '  repo  : %s@%s\n' "$REPO" "$BRANCH"
  printf '  fpm   : %s\n' "$FPM_SERVICE"
  cli version 2>/dev/null || true
}

c_uninstall(){
  warn "فایل‌ها، وب‌سرور و کران SR-BOT حذف می‌شود."
  local a="" b=""
  read -r -p "برای تأیید yes تایپ کنید: " a || true
  if [ "$a" != "yes" ]; then say "لغو شد."; return 0; fi
  read -r -p "دیتابیس $DB_NAME هم حذف شود؟ (y/n) [n]: " b || true
  if [ -d "$ROOT_DIR/storage/backups" ]; then
    mkdir -p /root/sr-bot-backups
    cp -a "$ROOT_DIR/storage/backups/." /root/sr-bot-backups/ 2>/dev/null || true
    ok "بکاپ‌ها در /root/sr-bot-backups نگه داشته شد."
  fi
  rm -f /etc/cron.d/sr-bot "$VHOST" /etc/nginx/sites-enabled/sr-bot.conf
  systemctl reload nginx >/dev/null 2>&1 || true
  rm -rf "$ROOT_DIR"
  if [ "$b" = "y" ]; then
    mysql -uroot -e "DROP DATABASE IF EXISTS $DB_NAME;" >/dev/null 2>&1 || warn "حذف دیتابیس ناموفق بود."
  fi
  rm -f /usr/local/bin/srui
  ok "حذف شد. برای پاکسازی کامل: rm -f /usr/local/bin/sr-ui /etc/sr-bot/sr-ui.conf"
  exit 0
}

menu(){
  while true; do
    printf '\n%s\n' "${CB}=========== SR-UI | مدیریت SR-BOT ===========${C0}"
    cat <<'M'
 1) وضعیت سرویس‌ها        9) نصب یا تمدید SSL
 2) ری‌استارت وب و PHP    10) تغییر دامنه یا پورت
 3) به‌روزرسانی ربات      11) مدیریت کران
 4) بکاپ گرفتن           12) نمایش لاگ‌ها
 5) بازیابی بکاپ         13) اصلاح مجوز فایل‌ها
 6) مهاجرت دیتابیس       14) کنسول دیتابیس
 7) وبهوک تلگرام          15) اطلاعات نصب
 8) تغییر توکن ربات        16) حذف کامل
 0) خروج
M
    local c=""
    read -r -p "انتخاب: " c || true
    case "$c" in
      1) c_status; pause ;;
      2) c_restart; pause ;;
      3) c_update; pause ;;
      4) c_backup; pause ;;
      5) c_restore; pause ;;
      6) cli migrate; pause ;;
      7) c_webhook; pause ;;
      8) c_token; pause ;;
      9) c_ssl; pause ;;
      10) c_domain; pause ;;
      11) c_cron; pause ;;
      12) c_logs; pause ;;
      13) c_perms; pause ;;
      14) c_db; pause ;;
      15) c_info; pause ;;
      16) c_uninstall ;;
      0) exit 0 ;;
      *) warn "گزینهٔ نامعتبر" ;;
    esac
  done
}

case "${1:-}" in
  status) c_status ;;
  start) c_start ;;
  stop) c_stop ;;
  restart) c_restart ;;
  update) c_update ;;
  backup) c_backup ;;
  restore) c_restore ;;
  migrate) cli migrate ;;
  check) cli check ;;
  webhook|hook) c_webhook ;;
  token) c_token ;;
  ssl) c_ssl ;;
  domain) c_domain ;;
  cron) c_cron ;;
  logs) c_logs ;;
  perms) c_perms ;;
  db) c_db ;;
  info) c_info ;;
  url) site_url; printf '\n' ;;
  version) cli version ;;
  uninstall) c_uninstall ;;
  help|-h|--help)
    printf '%s\n' "sr-ui [status|start|stop|restart|update|backup|restore|migrate|check|webhook|token|ssl|domain|cron|logs|perms|db|info|url|version|uninstall]" ;;
  "") menu ;;
  *) err "دستور ناشناخته: $1"; exit 1 ;;
esac
