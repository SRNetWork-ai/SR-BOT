# ==========================================================
#  مینی‌اپ تلگرام – اجازه نمایش داخل آی‌فریم تلگرام
#  رفع خطای "refused to connect"
# ==========================================================
<IfModule mod_headers.c>
  Header always unset X-Frame-Options
  Header unset X-Frame-Options
  Header always set Content-Security-Policy "frame-ancestors https://web.telegram.org https://*.telegram.org https://telegram.org https://*.t.me tg: 'self';"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

Options -Indexes
